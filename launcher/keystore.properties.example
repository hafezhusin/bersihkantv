# Copy to launcher/keystore.properties on the machine that publishes a release, then keep it out of git.
# Relative storeFile paths are resolved from launcher/, so ../keys/cleanyourtv-release.jks means
# <repo>/keys/cleanyourtv-release.jks.
storeFile=../keys/cleanyourtv-release.jks
storePassword=
keyAlias=cleanyourtv
keyPassword=
